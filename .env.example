# Required for Gemini API calls
GEMINI_API_KEY=GEMINI_API_KEY=your_api_key_here

# Current Gemini model. Change if your Google AI Studio account exposes another model.
GEMINI_MODEL=gemini-2.5-flash

# Optional: true attempts the documented LaMini-Flan-T5 local explanation model.
# It requires transformers + torch and downloads a large model on first use.
USE_LOCAL_EXPLAINER=false
